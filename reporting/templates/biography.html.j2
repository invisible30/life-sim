<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ person.name }} · 18 → 30 岁的人生沙盘</title>
  <style>
    /* ------------------------------------------------------------------ *
     *  Design tokens
     * ------------------------------------------------------------------ */
    :root {
      --bg:            #0a0e1a;
      --bg-2:          #0f1422;
      --panel:         #131a2a;
      --panel-2:       #1a2336;
      --panel-3:       #1f2940;
      --border:        #2a3550;
      --border-soft:   rgba(240, 198, 116, 0.18);
      --text:          #e6e6e6;
      --text-2:        #b8c4d1;
      --text-muted:    #8a9bae;
      --text-dim:      #5a6a82;
      --accent:        #f0c674;   /* gold */
      --accent-2:      #ffd98a;
      --good:          #4ade80;
      --good-bg:       rgba(74, 222, 128, 0.10);
      --good-border:   rgba(74, 222, 128, 0.35);
      --mid:           #f0c674;
      --mid-bg:        rgba(240, 198, 116, 0.10);
      --mid-border:    rgba(240, 198, 116, 0.35);
      --bad:           #f87171;
      --bad-bg:        rgba(248, 113, 113, 0.10);
      --bad-border:    rgba(248, 113, 113, 0.35);

      /* Agent colors — mirror the colors used in chart_builder & html_builder */
      --c-rational:   #5b8def;
      --c-emotional:  #ef6b9c;
      --c-ambitious:  #ff7b39;
      --c-realistic:  #8e8e93;
      --c-family:     #b07cff;
      --c-future:     #5ec5d6;
      --c-body:       #82c474;
      --c-luck:       #f0c674;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
                   "Microsoft YaHei", "Source Han Sans CN",
                   "Hiragino Sans GB", "Noto Sans CJK SC", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    h1, h2, h3, h4 { color: var(--text); font-weight: 600; letter-spacing: -0.01em; }
    h2 {
      font-size: 22px;
      margin: 56px 0 20px 0;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 10px;
    }
    h2 .h2-icon { font-size: 22px; }
    h3 { font-size: 16px; margin: 0; }
    p  { margin: 4px 0; }
    a  { color: var(--accent); text-decoration: none; }
    a:hover { color: var(--accent-2); }
    .section-sub {
      color: var(--text-muted);
      font-size: 13px;
      margin: -12px 0 20px 0;
    }

    /* ------------------------------------------------------------------ *
     *  Hero / animated gradient
     * ------------------------------------------------------------------ */
    .hero {
      position: relative;
      overflow: hidden;
      padding: 56px 32px 48px;
      border-bottom: 1px solid var(--border);
      isolation: isolate;
    }
    .hero-bg {
      position: absolute; inset: 0;
      z-index: -1;
      background:
        radial-gradient(circle at 20% 0%, rgba(91, 141, 239, 0.20), transparent 55%),
        radial-gradient(circle at 85% 30%, rgba(240, 198, 116, 0.18), transparent 50%),
        radial-gradient(circle at 50% 100%, rgba(176, 124, 255, 0.15), transparent 60%),
        linear-gradient(180deg, #0d1322 0%, #0a0e1a 100%);
      animation: heroShift 18s ease-in-out infinite alternate;
    }
    .hero-bg::after {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(240, 198, 116, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(240, 198, 116, 0.04) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    }
    @keyframes heroShift {
      0%   { transform: translate3d(0, 0, 0) scale(1);    filter: hue-rotate(0deg); }
      100% { transform: translate3d(-2%, 1%, 0) scale(1.05); filter: hue-rotate(8deg); }
    }
    .hero-inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; align-items: center; gap: 32px; flex-wrap: wrap;
    }
    .avatar {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #b07cff);
      color: #0a0e1a;
      font-size: 44px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 8px 32px rgba(240, 198, 116, 0.25),
                  inset 0 0 0 2px rgba(255, 255, 255, 0.18);
      flex-shrink: 0;
    }
    .hero-text { flex: 1; min-width: 240px; }
    .hero h1 {
      font-size: 32px;
      margin: 0 0 6px 0;
      background: linear-gradient(120deg, #fff 0%, var(--accent) 80%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .hero .subtitle {
      color: var(--text-2);
      font-size: 15px;
      margin: 0 0 14px 0;
    }
    .pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px 0; }
    .pill {
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 12px; font-weight: 500;
      border: 1px solid transparent;
      white-space: nowrap;
    }
    .pill-positive { background: rgba(91, 141, 239, 0.12);  color: #93b4f7; border-color: rgba(91, 141, 239, 0.30); }
    .pill-neutral  { background: rgba(148, 163, 184, 0.10); color: #cbd5e1; border-color: rgba(148, 163, 184, 0.28); }
    .pill-accent   { background: rgba(240, 198, 116, 0.12); color: var(--accent); border-color: rgba(240, 198, 116, 0.35); }
    .pill-muted    { background: rgba(176, 124, 255, 0.10); color: #d4baff; border-color: rgba(176, 124, 255, 0.28); }

    .stat-strip {
      display: inline-flex; flex-wrap: wrap; gap: 4px 18px;
      color: var(--text-2); font-size: 14px;
      padding: 10px 16px;
      background: rgba(15, 20, 34, 0.6);
      border: 1px solid var(--border);
      border-radius: 10px;
      backdrop-filter: blur(6px);
    }
    .stat-strip .sep { color: var(--text-dim); }
    .stat-strip strong { color: var(--accent); font-weight: 600; }

    /* ------------------------------------------------------------------ *
     *  Layout
     * ------------------------------------------------------------------ */
    main {
      max-width: 1200px; margin: 0 auto; padding: 16px 32px 80px;
    }
    @media (max-width: 700px) {
      main { padding: 16px 16px 64px; }
      .hero { padding: 40px 20px 36px; }
      .hero h1 { font-size: 24px; }
      .avatar { width: 72px; height: 72px; font-size: 32px; }
    }

    /* ------------------------------------------------------------------ *
     *  Charts
     * ------------------------------------------------------------------ */
    .charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 820px) { .charts-grid { grid-template-columns: 1fr; } }
    .chart-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px 22px 18px;
      transition: border-color .2s;
    }
    .chart-card:hover { border-color: var(--border-soft); }
    .chart-card h3 {
      color: var(--text-2);
      font-size: 14px; font-weight: 500;
      margin: 0 0 14px 0;
      display: flex; align-items: center; gap: 8px;
    }
    .chart-card canvas { width: 100% !important; height: 240px !important; }

    /* ------------------------------------------------------------------ *
     *  Scorecard
     * ------------------------------------------------------------------ */
    .scorecard-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    @media (max-width: 900px) { .scorecard-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 460px) { .scorecard-grid { grid-template-columns: 1fr; } }
    .score-card {
      position: relative;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 22px 20px 18px;
      overflow: hidden;
      transition: transform .2s, border-color .2s;
    }
    .score-card:hover { transform: translateY(-2px); border-color: var(--border-soft); }
    .score-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--card-accent, var(--accent));
      opacity: 0.7;
    }
    .score-card.score-good { --card-accent: var(--good); background: linear-gradient(180deg, var(--good-bg) 0%, var(--panel) 60%); border-color: var(--good-border); }
    .score-card.score-mid  { --card-accent: var(--mid);  background: linear-gradient(180deg, var(--mid-bg)  0%, var(--panel) 60%); border-color: var(--mid-border); }
    .score-card.score-bad  { --card-accent: var(--bad);  background: linear-gradient(180deg, var(--bad-bg)  0%, var(--panel) 60%); border-color: var(--bad-border); }
    .score-icon { font-size: 22px; margin-bottom: 8px; }
    .score-value {
      font-size: 32px; font-weight: 700;
      color: var(--text);
      line-height: 1.1;
      font-feature-settings: "tnum";
    }
    .score-value .score-unit {
      font-size: 14px; font-weight: 400; color: var(--text-muted);
      margin-left: 4px;
    }
    .score-label {
      color: var(--text-2);
      font-size: 13px;
      margin-top: 6px;
    }
    .score-card .score-tag {
      position: absolute; top: 14px; right: 14px;
      font-size: 11px; padding: 2px 8px; border-radius: 999px;
      font-weight: 500; letter-spacing: 0.04em;
    }
    .score-card.score-good .score-tag { background: var(--good-bg); color: var(--good); border: 1px solid var(--good-border); }
    .score-card.score-mid  .score-tag { background: var(--mid-bg);  color: var(--mid);  border: 1px solid var(--mid-border); }
    .score-card.score-bad  .score-tag { background: var(--bad-bg);  color: var(--bad);  border: 1px solid var(--bad-border); }

    /* ------------------------------------------------------------------ *
     *  Decision timeline
     * ------------------------------------------------------------------ */
    .timeline {
      position: relative;
      padding-left: 28px;
      margin-top: 8px;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 8px; top: 6px; bottom: 6px;
      width: 2px;
      background: linear-gradient(180deg, var(--accent) 0%, var(--border) 80%);
      opacity: 0.5;
    }
    .decision-card {
      position: relative;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px 22px 18px;
      margin-bottom: 20px;
    }
    .decision-card::before {
      content: '';
      position: absolute;
      left: -25px; top: 24px;
      width: 12px; height: 12px;
      background: var(--accent);
      border: 2px solid var(--bg);
      border-radius: 50%;
      box-shadow: 0 0 0 2px var(--accent);
    }
    .decision-header {
      display: flex; flex-wrap: wrap; gap: 8px;
      align-items: center;
      margin-bottom: 12px;
    }
    .quarter-badge {
      background: var(--panel-3);
      color: var(--accent);
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.05em;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    }
    .age-pill {
      background: rgba(91, 141, 239, 0.15);
      color: #93b4f7;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 12px; font-weight: 500;
    }
    .event-type-badge {
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 12px; font-weight: 500;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      color: var(--accent);
      border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    }
    .event-type-badge[style*="--accent: #ef4444"] { color: #f87171; }
    .llm-budget-badge {
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 12px; font-weight: 500;
      background: rgba(245, 158, 11, 0.12);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.4);
    }
    .event-title {
      font-size: 17px; font-weight: 600;
      color: var(--text);
      margin: 0 0 6px 0;
    }
    .event-desc {
      color: var(--text-2);
      font-size: 13px;
      margin: 0 0 14px 0;
    }

    .chosen-row {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      margin: 10px 0 12px 0;
      padding: 10px 14px;
      background: linear-gradient(90deg, rgba(240, 198, 116, 0.10), rgba(240, 198, 116, 0.02));
      border-left: 3px solid var(--accent);
      border-radius: 0 8px 8px 0;
    }
    .chosen-label { color: var(--text-muted); font-size: 13px; }
    .chosen-option {
      color: var(--accent);
      font-weight: 600;
      font-size: 14px;
    }

    /* vote chips row */
    .vote-chips {
      display: flex; flex-wrap: wrap; gap: 6px;
      margin: 8px 0 12px 0;
    }
    .vote-chip {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 12px; font-weight: 500;
      border: 1px solid transparent;
    }
    .vote-chip strong { font-family: ui-monospace, monospace; }
    .vote-chip.support-strong { background: #1a4d3a; color: #4ade80; border-color: rgba(74, 222, 128, 0.4); }
    .vote-chip.support        { background: #1a3d2a; color: #6ee7a0; border-color: rgba(110, 231, 160, 0.35); }
    .vote-chip.neutral        { background: #2d3e50; color: #94a3b8; border-color: rgba(148, 163, 184, 0.25); }
    .vote-chip.oppose         { background: #4a1a1a; color: #f87171; border-color: rgba(248, 113, 113, 0.35); }
    .vote-chip.oppose-strong  { background: #5a1a1a; color: #ef4444; border-color: rgba(239, 68, 68, 0.4); }
    .vote-chip .chip-emoji { font-size: 13px; }

    /* vote bar chart */
    .vote-bars {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      margin: 8px 0 12px 0;
      padding: 12px 14px;
      background: var(--bg-2);
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .vote-bar-row {
      display: grid;
      grid-template-columns: 130px 1fr 24px;
      align-items: center;
      gap: 10px;
      font-size: 12px;
    }
    .vote-bar-label {
      color: var(--text-2);
      display: flex; align-items: center; gap: 4px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .vote-bar-track {
      position: relative;
      height: 8px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 4px;
      display: flex; align-items: center;
      overflow: hidden;
    }
    .vote-bar-track::before {
      content: ''; position: absolute; left: 50%; top: -2px; bottom: -2px;
      width: 1px; background: var(--border);
    }
    .vote-bar-fill {
      position: absolute;
      top: 0; bottom: 0;
      border-radius: 4px;
      transition: width .4s;
    }
    .vote-bar-pos { left: 50%; }
    .vote-bar-neg { right: 50%; }
    .vote-bar-zero {
      position: absolute; left: 50%; top: 50%;
      width: 4px; height: 4px;
      border-radius: 50%;
      background: var(--text-dim);
      transform: translate(-50%, -50%);
    }
    .vote-bar-weight {
      font-family: ui-monospace, monospace;
      color: var(--text-muted);
      text-align: right;
    }

    /* score chips */
    .score-chips {
      display: flex; flex-wrap: wrap; gap: 6px; align-items: center;
      margin: 8px 0 12px 0;
    }
    .score-chips-label {
      color: var(--text-muted);
      font-size: 12px;
      margin-right: 4px;
    }
    .score-chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 3px 10px;
      border-radius: 6px;
      background: var(--panel-3);
      color: var(--text-2);
      font-size: 12px;
      border: 1px solid var(--border);
      max-width: 320px;
    }
    .score-chip.chosen {
      background: rgba(240, 198, 116, 0.15);
      color: var(--accent);
      border-color: rgba(240, 198, 116, 0.4);
      font-weight: 500;
    }
    .score-chip .score-chip-opt {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      max-width: 240px;
    }
    .score-chip .score-chip-val {
      font-family: ui-monospace, monospace;
      font-weight: 600;
      color: var(--text);
    }

    /* luck note */
    .luck-note {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px;
      background: rgba(240, 198, 116, 0.10);
      border: 1px dashed rgba(240, 198, 116, 0.4);
      border-radius: 6px;
      color: var(--accent);
      font-size: 12px;
      margin: 0 0 12px 0;
    }

    /* outcome */
    .outcome-pill {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      background: rgba(130, 196, 116, 0.10);
      color: #82c474;
      font-size: 12px;
      border: 1px solid rgba(130, 196, 116, 0.3);
      margin: 0 8px 12px 0;
    }

    /* collapsible debate */
    details.collapsible {
      margin-top: 4px;
      border-top: 1px dashed var(--border);
      padding-top: 10px;
    }
    details.collapsible > summary {
      cursor: pointer; user-select: none;
      color: var(--text-2);
      font-size: 13px;
      padding: 4px 0;
      list-style: none;
      display: inline-flex; align-items: center; gap: 6px;
    }
    details.collapsible > summary::-webkit-details-marker { display: none; }
    details.collapsible > summary::before {
      content: '▸';
      color: var(--accent);
      transition: transform .2s;
      display: inline-block;
    }
    details.collapsible[open] > summary::before { transform: rotate(90deg); }
    details.collapsible > summary:hover { color: var(--accent); }

    .debate-list { margin-top: 12px; }
    .debate {
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: 6px;
      padding: 12px 14px;
      margin-bottom: 8px;
    }
    .debate-author {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 6px;
      font-size: 13px;
    }
    .debate-emoji { font-size: 14px; }
    .debate-role { color: var(--accent); font-weight: 600; }
    .debate-round {
      color: var(--text-dim);
      font-size: 11px;
      font-family: ui-monospace, monospace;
      padding: 1px 6px;
      background: var(--panel-3);
      border-radius: 4px;
    }
    .debate-content {
      color: var(--text-2);
      font-size: 13px;
      white-space: pre-wrap;
      word-break: break-word;
      line-height: 1.65;
    }
    /* Per-agent debate accent stripes */
    .debate[data-agent="rational"]   { border-left-color: var(--c-rational); }
    .debate[data-agent="rational"]   .debate-role { color: var(--c-rational); }
    .debate[data-agent="emotional"]  { border-left-color: var(--c-emotional); }
    .debate[data-agent="emotional"]  .debate-role { color: var(--c-emotional); }
    .debate[data-agent="ambitious"]  { border-left-color: var(--c-ambitious); }
    .debate[data-agent="ambitious"]  .debate-role { color: var(--c-ambitious); }
    .debate[data-agent="realistic"]  { border-left-color: var(--c-realistic); }
    .debate[data-agent="realistic"]  .debate-role { color: var(--c-realistic); }
    .debate[data-agent="family"]     { border-left-color: var(--c-family); }
    .debate[data-agent="family"]     .debate-role { color: var(--c-family); }
    .debate[data-agent="future_me"]  { border-left-color: var(--c-future); }
    .debate[data-agent="future_me"]  .debate-role { color: var(--c-future); }
    .debate[data-agent="body"]       { border-left-color: var(--c-body); }
    .debate[data-agent="body"]       .debate-role { color: var(--c-body); }
    .debate[data-agent="luck"]       { border-left-color: var(--c-luck); }
    .debate[data-agent="luck"]       .debate-role { color: var(--c-luck); }

    /* ------------------------------------------------------------------ *
     *  Agent radar
     * ------------------------------------------------------------------ */
    .radar-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px;
    }
    .radar-card canvas {
      width: 100% !important;
      max-height: 480px;
    }

    /* ------------------------------------------------------------------ *
     *  Letter
     * ------------------------------------------------------------------ */
    .letter-card {
      position: relative;
      background:
        linear-gradient(135deg, #1a2336 0%, #0f1422 100%);
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 40px 48px 36px;
      color: var(--text-2);
      font-style: italic;
      line-height: 1.95;
      font-size: 15.5px;
      white-space: pre-wrap;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      overflow: hidden;
    }
    .letter-card::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        radial-gradient(circle at 20% 30%, rgba(240, 198, 116, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(91, 141, 239, 0.04) 0%, transparent 50%);
      pointer-events: none;
    }
    .letter-card::after {
      content: '';
      position: absolute; inset: 0;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.9  0 0 0 0 0.8  0 0 0 0 0.5  0 0 0 0.06 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
      opacity: 0.45;
      pointer-events: none;
      mix-blend-mode: overlay;
    }
    .letter-card > * { position: relative; }
    .letter-card .dropcap::first-letter {
      float: left;
      font-size: 56px;
      line-height: 0.9;
      padding: 6px 10px 0 0;
      font-weight: 700;
      font-style: normal;
      color: var(--accent);
      background: linear-gradient(180deg, var(--accent), #b07cff);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* ------------------------------------------------------------------ *
     *  Footer
     * ------------------------------------------------------------------ */
    footer {
      max-width: 1200px; margin: 0 auto;
      padding: 32px;
      color: var(--text-dim);
      font-size: 12px;
      text-align: center;
      border-top: 1px solid var(--border);
    }

    /* ------------------------------------------------------------------ *
     *  Print
     * ------------------------------------------------------------------ */
    @media print {
      body { background: white; color: #1a1a1a; }
      .hero-bg { display: none; }
      .hero { background: white; border-bottom: 1px solid #ccc; }
      .hero h1 { color: #1a1a1a; -webkit-text-fill-color: #1a1a1a; }
      .chart-card, .score-card, .decision-card, .radar-card, .letter-card {
        background: white; color: #1a1a1a; border: 1px solid #ccc;
        break-inside: avoid;
      }
      details.collapsible > summary { display: none; }
      details.collapsible .debate-list { display: block !important; }
      .pill, .vote-chip, .event-type-badge, .outcome-pill, .score-chip, .luck-note, .llm-budget-badge {
        border: 1px solid #999 !important; color: #1a1a1a !important; background: white !important;
      }
    }
  </style>
</head>
<body>

  <header class="hero">
    <div class="hero-bg"></div>
    <div class="hero-inner">
      <div class="avatar">{{ person.name[0] if person.name else "我" }}</div>
      <div class="hero-text">
        <h1>{{ person.name }} · 18 → 30岁的人生沙盘</h1>
        <p class="subtitle">
          {{ person.university }} ·
          {% if person.family_background == "upper" %}上层
          {% elif person.family_background == "middle" %}中产
          {% elif person.family_background == "working" %}工薪
          {% elif person.family_background == "rural" %}小镇
          {% else %}{{ person.family_background }}
          {% endif %}家庭 ·
          高考 {{ person.gaokao_score }}
        </p>
        {% if traits %}
        <div class="pills">
          {% for t in traits %}<span class="pill pill-{{ t.tone }}">{{ t.label }}</span>{% endfor %}
        </div>
        {% endif %}
        <div class="stat-strip">
          <span>共 <strong>{{ decision_count }}</strong> 个关键决策</span>
          <span class="sep">·</span>
          <span>调用 LLM <strong>{{ llm_calls }}</strong> 次</span>
          <span class="sep">·</span>
          <span>用时 <strong>{% if duration_min is not none %}{{ duration_min }}{% else %}—{% endif %}</strong> 分钟</span>
        </div>
      </div>
    </div>
  </header>

  <main>

    <section>
      <h2><span class="h2-icon">📈</span>人生曲线</h2>
      <p class="section-sub">18 → 30 岁，48 个季度的关键指标变化</p>
      <div class="charts-grid">
        <div class="chart-card">
          <h3>💰 净资产 &amp; 年收入</h3>
          <canvas id="chart-networth"></canvas>
        </div>
        <div class="chart-card">
          <h3>🧘 健康（身体 &amp; 心理）</h3>
          <canvas id="chart-health"></canvas>
        </div>
        <div class="chart-card">
          <h3>🚀 事业 &amp; 意义感</h3>
          <canvas id="chart-career"></canvas>
        </div>
        <div class="chart-card">
          <h3>⏳ 自由时间 &amp; 关系网</h3>
          <canvas id="chart-lifestyle"></canvas>
        </div>
      </div>
    </section>

    <section>
      <h2><span class="h2-icon">🎯</span>30岁终态</h2>
      <p class="section-sub">八个关键指标 — 绿色优秀，黄色一般，红色告警</p>
      <div class="scorecard-grid">
        {% for s in scorecard %}
        <div class="score-card score-{{ s.color }}">
          <span class="score-tag">
            {% if s.color == "good" %}优秀
            {% elif s.color == "mid" %}尚可
            {% else %}告警{% endif %}
          </span>
          <div class="score-icon">{{ s.icon }}</div>
          <div class="score-value">{{ s.display }}<span class="score-unit">{{ s.unit }}</span></div>
          <div class="score-label">{{ s.label }}</div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section>
      <h2><span class="h2-icon">📜</span>关键决策时间线</h2>
      <p class="section-sub">{{ decision_count }} 次人生董事会 · 7 个"我" + 1 个骰子</p>
      <div class="timeline">
        {% for d in decisions %}
        <article class="decision-card">
          <div class="decision-header">
            <span class="quarter-badge">Q{{ d.quarter }}</span>
            <span class="age-pill">{{ d.age }}岁</span>
            <span class="event-type-badge" style="--accent: {{ d.event_type_color }};">
              {{ d.event_icon }} {{ d.event_type_label }}
            </span>
            {% if d.llm_budget_exhausted %}
            <span class="llm-budget-badge" title="LLM 配额耗尽，agent votes 全部为 0">⚠️ LLM 限额</span>
            {% endif %}
          </div>
          <h3 class="event-title">{{ d.event_title }}</h3>
          {% if d.event_description %}
          <p class="event-desc">{{ d.event_description }}</p>
          {% endif %}

          <div class="chosen-row">
            <span class="chosen-label">最终选择</span>
            <span class="chosen-option">✓ {{ d.chosen }}</span>
          </div>

          <div class="vote-chips">
            {% for c in d.vote_chips %}
            <span class="vote-chip {{ c.cls }}" title="{{ c.role }}: {{ c.weight }}">
              <span class="chip-emoji">{{ c.emoji }}</span>
              <span>{{ c.role }}</span>
              <strong>{{ c.label }}</strong>
            </span>
            {% endfor %}
          </div>

          <div class="vote-bars" aria-label="agent vote breakdown">
            {% for b in d.vote_bars %}
            <div class="vote-bar-row">
              <span class="vote-bar-label"><span>{{ b.emoji }}</span>{{ b.role }}</span>
              <div class="vote-bar-track">
                {% if b.weight > 0 %}
                <div class="vote-bar-fill vote-bar-pos" style="width: {{ '%.0f' % b.pct }}%; background: {{ b.color }};"></div>
                {% elif b.weight < 0 %}
                <div class="vote-bar-fill vote-bar-neg" style="width: {{ '%.0f' % b.pct }}%; background: {{ b.color }};"></div>
                {% else %}
                <div class="vote-bar-zero"></div>
                {% endif %}
              </div>
              <span class="vote-bar-weight">
                {% if b.weight > 0 %}+{{ b.weight }}
                {% elif b.weight < 0 %}{{ b.weight }}
                {% else %}0{% endif %}
              </span>
            </div>
            {% endfor %}
          </div>

          {% if d.top_options %}
          <div class="score-chips">
            <span class="score-chips-label">得分最高的选项</span>
            {% for o in d.top_options %}
            <span class="score-chip {% if o.option == d.chosen %}chosen{% endif %}">
              <span class="score-chip-opt">{{ o.option }}</span>
              <span class="score-chip-val">{{ '%.1f' % o.score }}</span>
            </span>
            {% endfor %}
          </div>
          {% endif %}

          {% if d.luck_note %}<div class="luck-note">{{ d.luck_note }}</div>{% endif %}

          {% if d.outcome %}<div class="outcome-pill">结果：{{ d.outcome }}</div>{% endif %}

          {% if d.debates %}
          <details class="collapsible">
            <summary>展开董事会（{{ d.debates|length }} 条发言）</summary>
            <div class="debate-list">
              {% for db in d.debates %}
              <div class="debate" data-agent="{{ db.agent }}">
                <div class="debate-author">
                  <span class="debate-emoji">{{ db.emoji }}</span>
                  <span class="debate-role">{{ db.role }}</span>
                  <span class="debate-round">第{{ db.round }}轮</span>
                </div>
                <div class="debate-content">{{ db.content }}</div>
              </div>
              {% endfor %}
            </div>
          </details>
          {% endif %}
        </article>
        {% endfor %}
      </div>
    </section>

    <section>
      <h2><span class="h2-icon">🧭</span>7个"我"的影响力</h2>
      <p class="section-sub">按表达次数、投票强度、累计影响力、建议被采纳率、后悔准确度五个维度（已相对归一化到 0-100）</p>
      <div class="radar-card">
        <canvas id="chart-radar"></canvas>
      </div>
    </section>

    <section>
      <h2><span class="h2-icon">💌</span>30岁的我给18岁的我</h2>
      <div class="letter-card"><div class="dropcap">{{ letter | safe }}</div></div>
    </section>

  </main>

  <footer>
    由 Life Sim Multi-Agent 生成 · {{ decision_count }} 次决策 · {{ llm_calls }} 次 LLM 调用
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <script>
    'use strict';

    // ---------------------------------------------------------------
    // Data injected by the python side. Each is a JSON literal so we
    // can use it directly.
    // ---------------------------------------------------------------
    const metricsHistory = {{ metrics_history_json | safe }};
    const decisions      = {{ decisions_json | safe }};
    const finalScorecard = {{ final_scorecard_json | safe }};
    const agentStats     = {{ agent_stats_json | safe }};
    const agentMeta      = {{ agent_meta_json | safe }};

    // ---------------------------------------------------------------
    // Shared Chart.js options (dark theme)
    // ---------------------------------------------------------------
    const CHART_TEXT     = '#b8c4d1';
    const CHART_TEXT_DIM = '#5a6a82';
    const CHART_GRID     = 'rgba(255, 255, 255, 0.06)';
    const CHART_BORDER   = 'rgba(255, 255, 255, 0.12)';

    function baseLineOptions(extra) {
      return Object.assign({
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            labels: { color: CHART_TEXT, usePointStyle: true, padding: 12, font: { size: 11 } },
          },
          tooltip: {
            backgroundColor: 'rgba(15, 20, 34, 0.95)',
            borderColor: 'rgba(240, 198, 116, 0.4)',
            borderWidth: 1,
            titleColor: '#f0c674',
            bodyColor: '#e6e6e6',
            padding: 10,
            cornerRadius: 6,
          },
        },
        elements: {
          line:  { tension: 0.25, borderWidth: 2 },
          point: { radius: 0, hitRadius: 6, hoverRadius: 4 },
        },
        scales: {
          x: {
            ticks: { color: CHART_TEXT_DIM, font: { size: 10 }, maxRotation: 0, autoSkipPadding: 16 },
            grid:  { color: CHART_GRID, drawBorder: false },
            border: { display: false },
          },
          y: {
            beginAtZero: true,
            ticks: { color: CHART_TEXT_DIM, font: { size: 10 } },
            grid:  { color: CHART_GRID, drawBorder: false },
            border: { display: false },
          },
        },
      }, extra || {});
    }

    function extractSeries(history, key) {
      return history.map(snap => {
        const m = snap.metrics || {};
        return (m[key] !== undefined && m[key] !== null) ? Number(m[key]) : null;
      });
    }
    function quarters(history) {
      return history.map(snap => 'Q' + snap.quarter);
    }

    // ---------------------------------------------------------------
    // 1. Net worth + yearly income (dual axis)
    // ---------------------------------------------------------------
    {
      const labels = quarters(metricsHistory);
      const ctx = document.getElementById('chart-networth').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: '净资产 (万)',
              data: extractSeries(metricsHistory, '净资产(万)'),
              borderColor: '#f0c674',
              backgroundColor: 'rgba(240, 198, 116, 0.10)',
              yAxisID: 'y',
              fill: true,
            },
            {
              label: '年收入 (万)',
              data: extractSeries(metricsHistory, '年收入(万)'),
              borderColor: '#5b8def',
              backgroundColor: 'rgba(91, 141, 239, 0.10)',
              yAxisID: 'y1',
              borderDash: [4, 3],
            },
          ],
        },
        options: baseLineOptions({
          scales: {
            x:  { ticks: { color: CHART_TEXT_DIM, font: { size: 10 }, maxRotation: 0, autoSkipPadding: 16 },
                  grid: { color: CHART_GRID } },
            y:  { position: 'left',  beginAtZero: true,
                  ticks: { color: '#f0c674', font: { size: 10 }, callback: v => v + ' 万' },
                  grid:  { color: CHART_GRID }, title: { display: true, text: '净资产 (万)', color: '#f0c674' } },
            y1: { position: 'right', beginAtZero: true,
                  ticks: { color: '#5b8def', font: { size: 10 }, callback: v => v + ' 万' },
                  grid: { display: false }, title: { display: true, text: '年收入 (万)', color: '#5b8def' } },
          },
        }),
      });
    }

    // ---------------------------------------------------------------
    // 2. Physical + mental health (0-100)
    // ---------------------------------------------------------------
    {
      const ctx = document.getElementById('chart-health').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: quarters(metricsHistory),
          datasets: [
            { label: '身体健康', data: extractSeries(metricsHistory, '身体健康'),
              borderColor: '#82c474', backgroundColor: 'rgba(130, 196, 116, 0.10)', fill: true },
            { label: '心理健康', data: extractSeries(metricsHistory, '心理健康'),
              borderColor: '#ef6b9c', backgroundColor: 'rgba(239, 107, 156, 0.08)', fill: true, borderDash: [4, 3] },
          ],
        },
        options: baseLineOptions({
          scales: {
            y: { min: 0, max: 100, ticks: { color: CHART_TEXT_DIM, font: { size: 10 } }, grid: { color: CHART_GRID } },
          },
        }),
      });
    }

    // ---------------------------------------------------------------
    // 3. Career + meaning (0-100)
    // ---------------------------------------------------------------
    {
      const ctx = document.getElementById('chart-career').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: quarters(metricsHistory),
          datasets: [
            { label: '事业等级', data: extractSeries(metricsHistory, '事业等级'),
              borderColor: '#ff7b39', backgroundColor: 'rgba(255, 123, 57, 0.10)', fill: true },
            { label: '意义感',   data: extractSeries(metricsHistory, '意义感'),
              borderColor: '#b07cff', backgroundColor: 'rgba(176, 124, 255, 0.08)', fill: true, borderDash: [4, 3] },
          ],
        },
        options: baseLineOptions({
          scales: {
            y: { min: 0, max: 100, ticks: { color: CHART_TEXT_DIM, font: { size: 10 } }, grid: { color: CHART_GRID } },
          },
        }),
      });
    }

    // ---------------------------------------------------------------
    // 4. Free hours + relationship density
    // ---------------------------------------------------------------
    {
      const ctx = document.getElementById('chart-lifestyle').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: quarters(metricsHistory),
          datasets: [
            { label: '周自由小时', data: extractSeries(metricsHistory, '周自由小时'),
              borderColor: '#5ec5d6', backgroundColor: 'rgba(94, 197, 214, 0.10)', fill: true },
            { label: '关系网密度', data: extractSeries(metricsHistory, '关系网密度'),
              borderColor: '#b07cff', backgroundColor: 'rgba(176, 124, 255, 0.08)', fill: true, borderDash: [4, 3] },
          ],
        },
        options: baseLineOptions({
          scales: {
            y: { min: 0, ticks: { color: CHART_TEXT_DIM, font: { size: 10 } }, grid: { color: CHART_GRID } },
          },
        }),
      });
    }

    // ---------------------------------------------------------------
    // 5. Agent influence radar
    // ---------------------------------------------------------------
    {
      const axes = agentStats.axes;
      const datasets = agentStats.radar.map(agent => ({
        label: agent.emoji + ' ' + agent.role,
        data: agent.values,
        borderColor: agent.color,
        backgroundColor: hexToRgba(agent.color, 0.15),
        pointBackgroundColor: agent.color,
        pointBorderColor: agent.color,
        pointRadius: 3,
        pointHoverRadius: 5,
        borderWidth: 2,
      }));
      const ctx = document.getElementById('chart-radar').getContext('2d');
      new Chart(ctx, {
        type: 'radar',
        data: { labels: axes, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: CHART_TEXT, usePointStyle: true, padding: 12, font: { size: 11 } },
            },
            tooltip: {
              backgroundColor: 'rgba(15, 20, 34, 0.95)',
              borderColor: 'rgba(240, 198, 116, 0.4)',
              borderWidth: 1,
              titleColor: '#f0c674',
              bodyColor: '#e6e6e6',
              padding: 10,
              cornerRadius: 6,
            },
          },
          scales: {
            r: {
              min: 0, max: 100,
              ticks: { stepSize: 25, color: CHART_TEXT_DIM, backdropColor: 'transparent', font: { size: 10 } },
              grid:  { color: CHART_GRID },
              angleLines: { color: CHART_GRID },
              pointLabels: { color: CHART_TEXT, font: { size: 12 } },
            },
          },
        },
      });
    }

    // small helper: turn "#aabbcc" into "rgba(170, 187, 204, alpha)"
    function hexToRgba(hex, alpha) {
      const m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex || '');
      if (!m) return `rgba(148, 163, 184, ${alpha})`;
      return `rgba(${parseInt(m[1], 16)}, ${parseInt(m[2], 16)}, ${parseInt(m[3], 16)}, ${alpha})`;
    }
  </script>
</body>
</html>

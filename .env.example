# LLM Configuration
# Provider: openai (any OpenAI-compatible endpoint) or anthropic
LLM_PROVIDER=openai

# OpenAI / OpenAI-compatible (works for MiniMax)
OPENAI_API_KEY=sk-cp-your-key-here
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7-highspeed

# Anthropic (alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# MiniMax recommended model names:
#   MiniMax-M2.7-highspeed   (fast, good for agent debates)
#   MiniMax-M2.7             (default, more reasoning)
#   MiniMax-Text-01          (long context, 4M tokens)
# See https://platform.minimaxi.com/docs

# Simulation
LIFE_SEED=42
LIFE_OUTPUT_DIR=./output

# Cost guard rails
LIFE_MAX_LLM_CALLS=800
LIFE_TEMPERATURE=0.8
LIFE_PARALLEL_AGENTS=true
